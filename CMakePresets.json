{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang",
      "displayName": "Configure with clang/clang++",
      "description": "Use LLVM clang/clang++ toolchain",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "RAISERIALIZATION_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang-cl",
      "displayName": "Configure with clang-cl (MSVC ABI)",
      "description": "Use clang-cl for MSVC-compatible builds (requires MSVC headers/libs)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-cl",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "RAISERIALIZATION_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc",
      "displayName": "Configure with MSVC cl",
      "description": "Use MSVC cl with the Visual Studio generator",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-vs",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/utf-8",
        "RAISERIALIZATION_BUILD_TESTS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang",
      "displayName": "Build (clang) - Debug",
      "configuration": "Debug"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang",
      "displayName": "Build (clang) - Release",
      "configuration": "Release"
    },
    {
      "name": "clang-cl-debug",
      "configurePreset": "clang-cl",
      "displayName": "Build (clang-cl) - Debug",
      "configuration": "Debug"
    },
    {
      "name": "clang-cl-release",
      "configurePreset": "clang-cl",
      "displayName": "Build (clang-cl) - Release",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "displayName": "Build (MSVC) - Debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "displayName": "Build (MSVC) - Release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "clang-debug",
      "configurePreset": "clang",
      "displayName": "Test (clang) - Debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang-cl-debug",
      "configurePreset": "clang-cl",
      "displayName": "Test (clang-cl) - Debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "displayName": "Test (MSVC) - Debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
